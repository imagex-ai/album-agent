# ==========================================
# ENVIRONMENT CONFIGURATION - CLOUD / LOCAL
# ==========================================

# Google Gemini API Key (Essential for Cloud AI without GPU)
# Get yours for free at: https://aistudio.google.com/
GEMINI_API_KEY=""

# Security and Password Protection (Optional, but RECOMMENDED in Cloud/Public networks)
# If set, the browser will prompt for username and password when opening the app
AUTH_USERNAME="admin"
AUTH_PASSWORD=""

# Application execution port
PORT=8100

# Optional: Connect to an external/remote Ollama instance
OLLAMA_BASE_URL="http://localhost:11434"
# Hugging Face Cloud Storage & Backup (Optional)
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=""
HF_DATASET_REPO="seu-usuario/seu-dataset"

# Sincronização automática para nuvem (Opcional - padrão é false)
# Se false (recomendado), seus vídeos e álbuns ficam 100% locais no seu PC e o envio para a nuvem só ocorre quando você clica em "Fazer Backup".
AUTO_CLOUD_SYNC=false
